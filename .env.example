APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=mongodb://127.0.0.1:27017
DATABASE_NAME=occupancy_tracking
YOLO_MODEL_PATH=yolo11n.pt
YOLO_DEVICE=auto
YOLO_IMAGE_SIZE=640
YOLO_CONFIDENCE=0.35
YOLO_FP16=true
CAMERA_DEFAULT_FPS=15
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
INFERENCE_FPS=15
TRACKER_CONFIG=bytetrack.yaml
OCCUPANCY_SNAPSHOT_INTERVAL=30
WEBSOCKET_UPDATE_INTERVAL=1
PERSISTENCE_QUEUE_SIZE=1000
API_AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
CORS_ORIGINS=https://192.168.1.6:5173
PHONE_FRONTEND_URL=https://192.168.1.6:5173
PAIRING_TTL_SECONDS=120
PAIRING_ATTEMPTS_PER_MINUTE=30
WEBRTC_RECONNECT_GRACE_SECONDS=300
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URLS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
